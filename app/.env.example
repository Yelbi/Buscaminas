# Copy to .env.local for local overrides, or set in Vercel project settings.
# URL of the WebSocket game server (Render). Leave empty in dev — the Vite
# proxy forwards /ws to localhost:8787 automatically.
# In production, set this to your Render service URL to enable co-op / versus:
VITE_WS_URL=wss://buscaminas-ws.onrender.com

# Google Identity client ID for the GrandGames menu sign-in (optional).
# Works only on origins authorized in the Google Cloud console (localhost + your
# Vercel domain). Leave unset to use the project's built-in default client ID.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Server-side (game server / leaderboard) ─────────────────────────────
# For LOCAL dev: copy this file to `app/.env` and fill these in — the game
# server loads app/.env on start (via dotenv). In PRODUCTION these go in the
# RENDER service's Environment (never in Vercel). VITE_* are baked into the
# client at build time; the vars below are read by the server at runtime.

# Global leaderboard storage (Upstash Redis — free tier, no card needed).
# Create a Redis DB at https://upstash.com → REST API → copy both values.
# Without them the server reports enabled:false and the menu shows
# "La clasificación global aún no está configurada".
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Optional: lock the WS server to your frontend origin(s), comma-separated.
# ALLOWED_ORIGINS=https://tu-app.vercel.app
# Optional: override the server port (default 8787).
# PORT=8787
