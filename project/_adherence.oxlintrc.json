{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/game/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pixelify Sans|Space Grotesk|VT323))/i]",
        "message": "Font not provided by the design system. Available: Pixelify Sans, Space Grotesk, VT323."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, solid, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|magenta|lime|yellow|red|purple|neutral)$/]",
        "message": "<Badge> tone must be one of 'cyan' | 'magenta' | 'lime' | 'yellow' | 'red' | 'purple' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|value|owner|key|ref|className|style|children)$/]",
        "message": "<BoardCell> doesn't accept that prop. Declared props: state, value, owner."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCell'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:hidden|revealed|flagged|mine|exploded)$/]",
        "message": "<BoardCell> state must be one of 'hidden' | 'revealed' | 'flagged' | 'mine' | 'exploded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCell'] > JSXAttribute[name.name='owner'] > Literal[value!=/^(?:p1|p2)$/]",
        "message": "<BoardCell> owner must be one of 'p1' | 'p2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|disabled|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, disabled, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|win|danger|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'win' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|digits|tone|label|icon|style|key|ref|className|style|children)$/]",
        "message": "<Counter> doesn't accept that prop. Declared props: value, digits, tone, label, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|magenta|lime|yellow|red)$/]",
        "message": "<Counter> tone must be one of 'cyan' | 'magenta' | 'lime' | 'yellow' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|tone|children|footer|onClose|width|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, eyebrow, tone, children, footer, onClose, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|magenta|lime|red)$/]",
        "message": "<Dialog> tone must be one of 'cyan' | 'magenta' | 'lime' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|prefix|tone|mono|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, prefix, tone, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|magenta)$/]",
        "message": "<Input> tone must be one of 'cyan' | 'magenta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|icon|tone|players|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ModeCard> doesn't accept that prop. Declared props: title, subtitle, icon, tone, players, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|magenta|lime|purple)$/]",
        "message": "<ModeCard> tone must be one of 'cyan' | 'magenta' | 'lime' | 'purple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|slot|status|score|active|ready|style|key|ref|className|style|children)$/]",
        "message": "<PlayerTag> doesn't accept that prop. Declared props: name, slot, status, score, active, ready, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerTag'] > JSXAttribute[name.name='slot'] > Literal[value!=/^(?:p1|p2|host)$/]",
        "message": "<PlayerTag> slot must be one of 'p1' | 'p2' | 'host'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|tone|style|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: options, value, onChange, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cyan|magenta|lime)$/]",
        "message": "<Segmented> tone must be one of 'cyan' | 'magenta' | 'lime'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|value|size|owner|onClick|onContextMenu|style|key|ref|className|style|children)$/]",
        "message": "<Tile> doesn't accept that prop. Declared props: state, value, size, owner, onClick, onContextMenu, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:hidden|revealed|flagged|mine|exploded)$/]",
        "message": "<Tile> state must be one of 'hidden' | 'revealed' | 'flagged' | 'mine' | 'exploded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Tile> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute[name.name='owner'] > Literal[value!=/^(?:p1|p2)$/]",
        "message": "<Tile> owner must be one of 'p1' | 'p2'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
